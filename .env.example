# Copy this file to .env and fill in your own values. Never commit .env.
# Free keys: console.groq.com and aistudio.google.com
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Model chain, tried in order: provider:model, comma-separated (providers: groq, gemini).
# All are called through the OpenAI-compatible chat-completions API.
LLM_CHAIN=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite

# Demo protection: messages per visitor per day, and for all visitors together per day.
DEMO_MAX_PER_VISITOR=15
DEMO_DAILY_CAP=100

# Langfuse monitoring (free Hobby plan). Empty keys = monitoring off.
# Host: EU https://cloud.langfuse.com, US https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Shared store for serverless (Upstash Redis free plan): demo limits + model health.
# Empty = in-memory counters (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
